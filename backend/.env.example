# ================================================
# Malva Pastry Shop - Variables de Entorno
# ================================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env al repositorio.
#
# Salvo que se indique lo contrario, estas variables aplican al perfil dev.
# El perfil prod fija sus propios valores en application-prod.properties.
# ================================================

# --- Spring Profile ---
# dev  = DataSeeder activo, logs DEBUG, show-sql true
# prod = DataSeeder desactivado, logs WARN, show-sql false
SPRING_PROFILES_ACTIVE=dev

# --- Server ---
SERVER_PORT=8080

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/malva_pastry_db
DB_USERNAME=postgres
DB_PASSWORD=tu_password_seguro_aqui

# --- JPA / Hibernate ---
# Solo tienen efecto en dev: en prod el esquema lo gestiona Flyway y
# application-prod.properties fija ddl-auto=none con show-sql y format-sql en false.
# ddl-auto=create recrea el esquema en cada arranque y DataSeeder lo repuebla.
JPA_DDL_AUTO=create
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# --- CORS ---
# Origenes separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- URL publica del backend ---
# Origen que la API antepone a las rutas de imagen para devolver URLs absolutas.
# Vacio en local: la API responde rutas relativas (/images/...), validas mientras
# el frontend consuma desde el mismo origen.
PUBLIC_BASE_URL=

# --- Thymeleaf ---
THYMELEAF_CACHE=false

# --- Logging ---
# Niveles: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_APP=DEBUG

# ================================================
# Solo perfil prod (no hacen falta para correr en local)
# ================================================
# En Render las define el blueprint (render.yaml), que toma las de base de datos
# del servicio PostgreSQL vinculado. Quedan aca como referencia para reproducir
# el perfil prod fuera de Render.
#
# La conexion de prod no usa DB_URL: application-prod.properties arma la URL a
# partir de estas piezas porque el driver JDBC no parsea user:password@host.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=malva_pastry_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=tu_password_seguro_aqui
#
# Swagger viene deshabilitado en prod; ponerla en true para exponer /swagger-ui.html
# SWAGGER_ENABLED=false
